{
  "manifest_version": 3,
  "name": "Aura Music Player",
  "version": "1.0.0",
  "description": "一个用于播放在线音乐的浏览器扩展程序",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "windows", "fileSystem"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": "icons/simple-music-logo.png"
  },
  "icons": {
    "16": "icons/simple-music-logo.png",
    "48": "icons/simple-music-logo.png",
    "128": "icons/simple-music-logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
   "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "./js/eval5.js",
        "./js/common.js"
      ]
    }
  ]
}
